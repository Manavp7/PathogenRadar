# PathogenRadar configuration — ALL VALUES OPTIONAL.
# The platform runs fully offline with zero external AI dependencies if this file is absent.

# --- Region ---
PATHOGENRADAR_REGION=kerala

# --- Optional real public-data connectors ---
# If unset, weather uses synthetic/cached data. OpenWeather is an optional plug-in.
# OPENWEATHER_API_KEY=
# Enable real Google Trends pulls (pytrends). If unset/blocked, falls back to synthetic.
# ENABLE_GOOGLE_TRENDS=false

# --- Optional LLM provider for briefings (NEVER required) ---
# Provider: template (default, no AI) | openai | anthropic | gemini | ollama
LLM_PROVIDER=template
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# OLLAMA_BASE_URL=http://localhost:11434

# --- API security (optional) ---
# If set, API requires X-API-Key header. If unset, API is open (dev mode).
# PATHOGENRADAR_API_KEY=
